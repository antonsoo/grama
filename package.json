{
  "name": "@antonsoloviev/grama",
  "version": "0.1.0",
  "private": true,
  "description": "Change a starting note, lower one string, and read the Sanskrit behind the two gramas.",
  "type": "module",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/grama.git"
  },
  "homepage": "https://antonsoo.github.io/grama/",
  "keywords": [
    "natya-shastra",
    "sanskrit",
    "music-theory",
    "tuning",
    "sruti",
    "grama",
    "history-of-music"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4394 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4394 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:oracle": "node --import tsx scripts/model-cases.ts | python3 scripts/model-oracle.py",
    "test:browser": "node scripts/browser-review.mjs",
    "verify:family": "node --import tsx scripts/family-cases.ts | python3 scripts/family-oracle.py",
    "test:family": "node scripts/family-browser.mjs",
    "verify:family-audio": "python3 scripts/family-wav-oracle.py",
    "test:source-json": "node scripts/source-json-development.mjs",
    "test:interactions": "node scripts/interaction-audit.mjs",
    "test:network": "node scripts/network-audit.mjs",
    "test:cold-save": "node scripts/cold-save-audit.mjs",
    "test:upgrade": "node scripts/upgrade-audit.mjs",
    "test:listening": "node scripts/listening-browser.mjs",
    "verify:listening-audio": "python3 scripts/listening-audio-oracle.py",
    "test:listening-record": "node scripts/listening-record-browser.mjs",
    "test:listening-save": "node scripts/listening-save-review.mjs",
    "test:attachment": "node scripts/attachment-browser.mjs",
    "test:record-open": "node scripts/record-open-browser.mjs",
    "verify:attachment-audio": "python3 scripts/attachment-audio-oracle.py",
    "test:shared-network": "node scripts/shared-bandwidth-audit.mjs",
    "test:startup": "node scripts/startup-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
